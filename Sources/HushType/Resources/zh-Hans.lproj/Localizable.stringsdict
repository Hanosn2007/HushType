<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<key>menu.dictionary.entries_loaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringFormatSpecTypeInt</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>l</string>
			<key>other</key>
			<string>已加载 %1$ld 个条目</string>
		</dict>
	</dict>

	<key>usage.daily_breakdown</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringFormatSpecTypeInt</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>l</string>
			<key>other</key>
			<string>今天的云端费用：合计 %1$@ — 语音输入 %2$@（%3$d 分钟），实时翻译字幕 %4$@（%5$d 分钟）</string>
		</dict>
	</dict>

	<key>settings.duration.minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringFormatSpecTypeInt</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>l</string>
			<key>other</key>
			<string>%1$d 分钟</string>
		</dict>
	</dict>

	<key>settings.usage.today</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringFormatSpecTypeInt</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>l</string>
			<key>other</key>
			<string>今天的费用：%1$@（%2$d 分钟）</string>
		</dict>
	</dict>

	<key>notification.caption.auto_stop.body</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringFormatSpecTypeInt</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>l</string>
			<key>other</key>
			<string>已在 %1$d 分钟后停止（今天已使用 %2$@）。</string>
		</dict>
	</dict>

	<key>settings.dictionary.entry_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringFormatSpecTypeInt</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>l</string>
			<key>other</key>
			<string>已加载 %1$ld 条词典规则</string>
		</dict>
	</dict>

</dict>
</plist>
